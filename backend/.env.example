# Public examples for local development only. Replace before deployment.
SECRET_KEY=local-only-replace-with-a-generated-key-before-deployment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=pulso
POSTGRES_USER=pulso
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_HOST=127.0.0.1
# Host port; Compose uses postgres:5432 between containers.
POSTGRES_PORT=55432
REDIS_HOST=127.0.0.1
# Host port; Compose uses redis:6379 between containers.
REDIS_PORT=6399
# Optional; leave false for normal startup. See README worker infrastructure section.
CELERY_DIAGNOSTIC_BEAT_ENABLED=false
# Gates the News Beat schedules (news-poll-due-endpoints, news-reconcile-pending).
# Only the optional `beat` service reads it; false leaves Beat with no News entry.
NEWS_INGESTION_ENABLED=true
# How often Beat scans for endpoints due for ingestion, in seconds. Positive integer.
NEWS_POLL_DISPATCH_INTERVAL_SECONDS=300
# Keep false normally; true is only for controlled local test environments.
NEWS_FETCH_ALLOW_PRIVATE_NETWORKS=false
# Level for the `pulso` JSON log tree: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# Django's and Celery's own loggers are unaffected.
LOG_LEVEL=INFO
