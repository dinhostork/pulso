# Public examples for local development only. Replace before deployment.
SECRET_KEY=local-only-replace-with-a-generated-key-before-deployment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=pulso
POSTGRES_USER=pulso
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_HOST=127.0.0.1
# Host port; Compose uses postgres:5432 between containers.
POSTGRES_PORT=55432
REDIS_HOST=127.0.0.1
# Host port; Compose uses redis:6379 between containers.
REDIS_PORT=6399
# Optional; leave false for normal startup. See README worker infrastructure section.
CELERY_DIAGNOSTIC_BEAT_ENABLED=false
