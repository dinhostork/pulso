    "last_published_at": "2026-03-04T12:00:00Z",
    "content_state": "CURRENT",
    "synthesis_id": "201",
    "synthesized_at": "2026-09-20T12:00:00Z",
    "title": "Storm forces closure of Elsby harbor",
    "elements": [
      {
        "id": "301",
        "kind": "TITLE",
        "position": 0,
        "text": "Storm forces closure of Elsby harbor",
        "article_ids": [
          "401"
        ]
      },
      {
        "id": "302",
        "kind": "SUMMARY",
        "position": 0,
        "text": "The Elsby Harbor Authority closed the harbor on Monday after overnight gales damaged two piers.",
        "article_ids": [
          "401"
        ]
      },
      {
        "id": "303",
        "kind": "SUMMARY",
        "position": 1,
        "text": "Elsby's harbor was closed to all shipping on Monday when storm winds broke sections of two piers, the harbor authority said.",
        "article_ids": [
          "402"
        ]
      },
      {
        "id": "304",
        "kind": "SUMMARY",
        "position": 2,
        "text": "Dozens of trawlers sat idle in Elsby on Monday, their crews unable to sail after a night of violent wind tore through the town's waterfront.",
        "article_ids": [
          "403"
        ]
      },
      {
        "id": "305",
        "kind": "CONTEXT",
        "position": 0,
        "text": "Harbor master Oren Vasko said no vessels may enter or leave until engineers inspect the damage.",
        "article_ids": [
          "401"
        ]
      },
      {
        "id": "306",
        "kind": "CONTEXT",
        "position": 1,
        "text": "Inspections are expected to take several days.",
        "article_ids": [
          "402"
        ]
      },
      {
        "id": "307",
        "kind": "CONTEXT",
        "position": 2,
        "text": "Port officials have barred all traffic while repairs are assessed.",
        "article_ids": [
          "403"
        ]
      },
      {
        "id": "308",
        "kind": "CONTEXT",
        "position": 3,
        "text": "Two days after storm damage closed the harbor, the Elsby Harbor Authority said the eastern berths will reopen next week.",
        "article_ids": [
          "404"
        ]
      }
    ],
